# ============================================
# VibeLab — переменные окружения
# Скопируй в .env.local и заполни значения
# НИКОГДА не коммить .env.local в git
# ============================================

# База данных (PostgreSQL на VPS)
DATABASE_URL="postgresql://user:password@your-vps-ip:5432/vibelab"

# Better Auth
BETTER_AUTH_SECRET="your-secret-key-min-32-chars"
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth (опционально)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ============================================
# Т-Банк Acquiring
# ============================================
TBANK_TERMINAL_KEY=""
TBANK_SECRET_KEY=""
# Для тестирования: https://rest-api-test.tinkoff.ru/v2/
# Для продакшна:    https://securepay.tinkoff.ru/v2/
TBANK_API_URL="https://rest-api-test.tinkoff.ru/v2/"

# ============================================
# Cloudflare R2 (хранилище медиа)
# ============================================
CLOUDFLARE_R2_ACCOUNT_ID=""
CLOUDFLARE_R2_ACCESS_KEY_ID=""
CLOUDFLARE_R2_SECRET_ACCESS_KEY=""
CLOUDFLARE_R2_BUCKET_NAME="vibelab-media"
CLOUDFLARE_R2_PUBLIC_URL="https://media.vibelab.ru"

# ============================================
# Kling / kie.ai (генерация видео)
# ============================================
KLING_API_KEY=""
KLING_API_URL="https://api.klingai.com"

# ============================================
# OpenRouter (текстовые генерации — поддерживает Claude, GPT, Gemini и др.)
# ============================================
OPENROUTER_API_KEY=""

# ============================================
# NanoBanana (маскоты и персонажи)
# ============================================
NANOBANANA_API_KEY=""
NANOBANANA_API_URL=""

# ============================================
# Soketi (Realtime — self-hosted на VPS)
# ============================================
SOKETI_HOST="your-vps-ip"
SOKETI_PORT="6001"
SOKETI_APP_ID="vibelab"
SOKETI_APP_KEY=""
SOKETI_APP_SECRET=""

# Next.js публичные переменные (доступны на клиенте)
NEXT_PUBLIC_SOKETI_HOST="your-vps-ip"
NEXT_PUBLIC_SOKETI_PORT="6001"
NEXT_PUBLIC_SOKETI_APP_KEY=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ============================================
# Instagram Graph API (автопостинг)
# ============================================
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""

# ============================================
# YouTube Data API v3 (автопостинг)
# ============================================
YOUTUBE_API_KEY=""
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""

# ============================================
# Telegram Bot (уведомления и канал)
# ============================================
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHANNEL_ID=""
